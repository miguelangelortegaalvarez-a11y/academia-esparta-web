 "css": ".mz *,.mz *::before,.mz *::after{box-sizing: border-box; margin: 0; padding: 0;}\n.mz .figura-mini{width: 38px; height: 38px;}\n.mz .objetos-grid{display: grid; grid-template-columns: 1fr 1fr; gap: 6px 40px; align-items: center;}\n.mz .objetos-col{display: flex; flex-direction: column; gap: 7px; align-items: center;}\n.mz .objeto-caja{display: flex; align-items: center; gap: 8px; min-height: 40px;}\n.mz .objeto-caja svg{width: 40px; height: 40px;}\n.mz .objeto-nombre{font-family: sans-serif; font-size: 10px; color: #555;}\n.mz .objetos-nom{border: 1.5px solid var(--bosque); border-radius: 8px; padding: 5px 8px; text-align: center; font-size: 13px; font-weight: 700; width: 100%;}\n.mz .escena-grid{display: grid; grid-template-columns: 270px 1fr; gap: 16px; align-items: center;}\n.mz .escena-caja{border: 1.5px solid var(--bosque); border-radius: 10px; padding: 5px; display: flex; justify-content: center;}\n.mz .conteo-lista{display: flex; flex-direction: column; gap: 5px;}\n.mz .conteo-item{display: flex; align-items: center; gap: 8px; font-size: 12.5px; font-weight: 600;}\n.mz .conteo-hueco{width: 34px; height: 22px; border: 1.5px solid var(--bosque); border-radius: 5px; flex-shrink: 0;}\n.mz .conteo-fig{width: 24px; height: 24px; flex-shrink: 0;}\n.mz .intruso-fila{display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 5px;}\n.mz .intruso-fig{border: 1.5px dashed #000; border-radius: 8px; padding: 3px; display: flex; align-items: center; justify-content: center; min-height: 50px;}\n.mz .frases{display: flex; flex-direction: column; gap: 12px;}\n.mz .frase{font-size: 13.5px; line-height: 1.5;}\n.mz .hueco-frase{display: inline-block; border-bottom: 1.5px solid var(--bosque); min-width: 100px; height: 16px; vertical-align: bottom;}\n.mz .frase{line-height: 1.725 !important;}",
 "badge": "🧊 Cuerpos geométricos en el mundo real",
 "bloques": [
  "<div class=\"ej-block\">\n    <div class=\"ej-enunciado\"><span class=\"num\">1.</span> <strong>Une</strong> cada objeto con el cuerpo geométrico que tiene su <strong>forma</strong>:</div>\n    <div class=\"objetos-grid\">\n      <div class=\"objetos-col\">\n        <div class=\"objeto-caja\">\n          <svg viewBox=\"0 0 60 60\">\n            <ellipse cx=\"30\" cy=\"12\" rx=\"16\" ry=\"5\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <line x1=\"14\" y1=\"12\" x2=\"14\" y2=\"48\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <line x1=\"46\" y1=\"12\" x2=\"46\" y2=\"48\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <path d=\"M 14 48 A 16 5 0 0 0 46 48\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <line x1=\"14\" y1=\"24\" x2=\"46\" y2=\"24\" stroke=\"#000\" stroke-width=\"1.2\"/>\n            <line x1=\"14\" y1=\"38\" x2=\"46\" y2=\"38\" stroke=\"#000\" stroke-width=\"1.2\"/>\n          </svg>\n          <span class=\"objeto-nombre\">lata</span>\n        </div>\n        <div class=\"objeto-caja\">\n          <svg viewBox=\"0 0 60 60\">\n            <line x1=\"30\" y1=\"8\" x2=\"8\" y2=\"50\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n            <line x1=\"30\" y1=\"8\" x2=\"52\" y2=\"50\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n            <line x1=\"30\" y1=\"8\" x2=\"30\" y2=\"56\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n            <polyline points=\"8,50 30,56 52,50\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n            <line x1=\"15\" y1=\"36\" x2=\"45\" y2=\"36\" stroke=\"#000\" stroke-width=\"1.2\"/>\n            <line x1=\"11\" y1=\"44\" x2=\"49\" y2=\"44\" stroke=\"#000\" stroke-width=\"1.2\"/>\n          </svg>\n          <span class=\"objeto-nombre\">pirámide de Egipto</span>\n        </div>\n        <div class=\"objeto-caja\">\n          <svg viewBox=\"0 0 60 60\">\n            <rect x=\"10\" y=\"22\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <polygon points=\"10,22 22,10 52,10 40,22\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n            <polygon points=\"40,22 52,10 52,40 40,52\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n            <circle cx=\"25\" cy=\"37\" r=\"2.5\" fill=\"#000\"/>\n            <circle cx=\"18\" cy=\"30\" r=\"2.5\" fill=\"#000\"/>\n            <circle cx=\"32\" cy=\"44\" r=\"2.5\" fill=\"#000\"/>\n            <circle cx=\"34\" cy=\"14\" r=\"2\" fill=\"#000\"/>\n            <circle cx=\"46\" cy=\"28\" r=\"2\" fill=\"#000\"/>\n          </svg>\n          <span class=\"objeto-nombre\">dado</span>\n        </div>\n        <div class=\"objeto-caja\">\n          <svg viewBox=\"0 0 60 60\">\n            <circle cx=\"30\" cy=\"16\" r=\"11\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <ellipse cx=\"30\" cy=\"28\" rx=\"12\" ry=\"4\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n            <line x1=\"18\" y1=\"28\" x2=\"30\" y2=\"56\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <line x1=\"42\" y1=\"28\" x2=\"30\" y2=\"56\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <line x1=\"22\" y1=\"38\" x2=\"36\" y2=\"32\" stroke=\"#000\" stroke-width=\"1\"/>\n            <line x1=\"25\" y1=\"46\" x2=\"35\" y2=\"42\" stroke=\"#000\" stroke-width=\"1\"/>\n          </svg>\n          <span class=\"objeto-nombre\">cucurucho de helado</span>\n        </div>\n        <div class=\"objeto-caja\">\n          <svg viewBox=\"0 0 60 60\">\n            <rect x=\"6\" y=\"26\" width=\"32\" height=\"22\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <polygon points=\"6,26 16,16 48,16 38,26\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n            <polygon points=\"38,26 48,16 48,38 38,48\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n            <line x1=\"6\" y1=\"33\" x2=\"38\" y2=\"33\" stroke=\"#000\" stroke-width=\"1.2\"/>\n            <line x1=\"38\" y1=\"33\" x2=\"48\" y2=\"23\" stroke=\"#000\" stroke-width=\"1.2\"/>\n          </svg>\n          <span class=\"objeto-nombre\">caja de zapatos</span>\n        </div>\n        <div class=\"objeto-caja\">\n          <svg viewBox=\"0 0 60 60\">\n            <circle cx=\"30\" cy=\"30\" r=\"22\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <path d=\"M 12 18 Q 30 30 12 42\" fill=\"none\" stroke=\"#000\" stroke-width=\"1.5\"/>\n            <path d=\"M 48 18 Q 30 30 48 42\" fill=\"none\" stroke=\"#000\" stroke-width=\"1.5\"/>\n          </svg>\n          <span class=\"objeto-nombre\">pelota</span>\n        </div>\n      </div>\n      <div class=\"objetos-col\">\n        <div class=\"objetos-nom\">cubo</div>\n        <div class=\"objetos-nom\">cilindro</div>\n        <div class=\"objetos-nom\">prisma</div>\n        <div class=\"objetos-nom\">pirámide</div>\n        <div class=\"objetos-nom\">esfera</div>\n        <div class=\"objetos-nom\">cono</div>\n      </div>\n    </div>\n  </div>",
  "<div class=\"ej-block\">\n    <div class=\"ej-enunciado\"><span class=\"num\">2.</span> Observa los <strong>juguetes</strong> y cuenta cuántos cuerpos hay de cada tipo:</div>\n    <div class=\"escena-grid\">\n      <div class=\"escena-caja\">\n        <svg width=\"262\" height=\"212\" viewBox=\"0 0 260 210\">\n          <!-- regalo prisma -->\n          <rect x=\"8\" y=\"162\" width=\"52\" height=\"30\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n          <polygon points=\"8,162 18,152 70,152 60,162\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n          <polygon points=\"60,162 70,152 70,182 60,192\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n          <line x1=\"34\" y1=\"162\" x2=\"34\" y2=\"192\" stroke=\"#000\" stroke-width=\"1.2\"/>\n          <line x1=\"44\" y1=\"152\" x2=\"34\" y2=\"162\" stroke=\"#000\" stroke-width=\"1.2\"/>\n          <!-- pirámide juguete -->\n          <line x1=\"88\" y1=\"150\" x2=\"68\" y2=\"192\" stroke=\"#000\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          <line x1=\"88\" y1=\"150\" x2=\"108\" y2=\"192\" stroke=\"#000\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          <line x1=\"88\" y1=\"150\" x2=\"88\" y2=\"198\" stroke=\"#000\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          <polyline points=\"68,192 88,198 108,192\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n          <!-- muñeco: cubo peana -->\n          <rect x=\"120\" y=\"152\" width=\"48\" height=\"40\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n          <polygon points=\"120,152 132,140 180,140 168,152\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n          <polygon points=\"168,152 180,140 180,180 168,192\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n          <!-- muñeco: cilindro cuerpo -->\n          <ellipse cx=\"144\" cy=\"100\" rx=\"18\" ry=\"5\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n          <line x1=\"126\" y1=\"100\" x2=\"126\" y2=\"146\" stroke=\"#000\" stroke-width=\"2\"/>\n          <line x1=\"162\" y1=\"100\" x2=\"162\" y2=\"146\" stroke=\"#000\" stroke-width=\"2\"/>\n          <path d=\"M 126 146 A 18 5 0 0 0 162 146\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n          <!-- muñeco: esfera cabeza -->\n          <circle cx=\"144\" cy=\"78\" r=\"19\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n          <!-- muñeco: cono gorro -->\n          <line x1=\"144\" y1=\"28\" x2=\"128\" y2=\"60\" stroke=\"#000\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          <line x1=\"144\" y1=\"28\" x2=\"160\" y2=\"60\" stroke=\"#000\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          <path d=\"M 128 60 A 16 4.5 0 0 0 160 60\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n          <!-- cono de tráfico -->\n          <line x1=\"204\" y1=\"140\" x2=\"188\" y2=\"192\" stroke=\"#000\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          <line x1=\"204\" y1=\"140\" x2=\"220\" y2=\"192\" stroke=\"#000\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n          <path d=\"M 188 192 A 16 5 0 0 0 220 192\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n          <line x1=\"194\" y1=\"172\" x2=\"214\" y2=\"172\" stroke=\"#000\" stroke-width=\"1.2\"/>\n          <!-- pelota esfera -->\n          <circle cx=\"240\" cy=\"178\" r=\"15\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n          <ellipse cx=\"240\" cy=\"178\" rx=\"15\" ry=\"5\" fill=\"none\" stroke=\"#000\" stroke-width=\"1.2\"/>\n        </svg>\n      </div>\n      <div class=\"conteo-lista\">\n        <div class=\"conteo-item\">\n          <svg class=\"conteo-fig\" viewBox=\"0 0 60 60\"><rect x=\"10\" y=\"22\" width=\"30\" height=\"30\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/><polygon points=\"10,22 22,10 52,10 40,22\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polygon points=\"40,22 52,10 52,40 40,52\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/></svg>\n          cubos: <span class=\"conteo-hueco\"></span>\n        </div>\n        <div class=\"conteo-item\">\n          <svg class=\"conteo-fig\" viewBox=\"0 0 60 60\"><rect x=\"6\" y=\"26\" width=\"32\" height=\"22\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/><polygon points=\"6,26 16,16 48,16 38,26\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polygon points=\"38,26 48,16 48,38 38,48\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/></svg>\n          prismas: <span class=\"conteo-hueco\"></span>\n        </div>\n        <div class=\"conteo-item\">\n          <svg class=\"conteo-fig\" viewBox=\"0 0 60 60\"><line x1=\"30\" y1=\"8\" x2=\"10\" y2=\"46\" stroke=\"#000\" stroke-width=\"3\" stroke-linecap=\"round\"/><line x1=\"30\" y1=\"8\" x2=\"50\" y2=\"46\" stroke=\"#000\" stroke-width=\"3\" stroke-linecap=\"round\"/><line x1=\"30\" y1=\"8\" x2=\"30\" y2=\"54\" stroke=\"#000\" stroke-width=\"3\" stroke-linecap=\"round\"/><polyline points=\"10,46 30,54 50,46\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/></svg>\n          pirámides: <span class=\"conteo-hueco\"></span>\n        </div>\n        <div class=\"conteo-item\">\n          <svg class=\"conteo-fig\" viewBox=\"0 0 60 60\"><circle cx=\"30\" cy=\"30\" r=\"22\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/><ellipse cx=\"30\" cy=\"30\" rx=\"22\" ry=\"7\" fill=\"none\" stroke=\"#000\" stroke-width=\"1.5\"/></svg>\n          esferas: <span class=\"conteo-hueco\"></span>\n        </div>\n        <div class=\"conteo-item\">\n          <svg class=\"conteo-fig\" viewBox=\"0 0 60 60\"><ellipse cx=\"30\" cy=\"12\" rx=\"16\" ry=\"5\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/><line x1=\"14\" y1=\"12\" x2=\"14\" y2=\"48\" stroke=\"#000\" stroke-width=\"3\"/><line x1=\"46\" y1=\"12\" x2=\"46\" y2=\"48\" stroke=\"#000\" stroke-width=\"3\"/><path d=\"M 14 48 A 16 5 0 0 0 46 48\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/></svg>\n          cilindros: <span class=\"conteo-hueco\"></span>\n        </div>\n        <div class=\"conteo-item\">\n          <svg class=\"conteo-fig\" viewBox=\"0 0 60 60\"><line x1=\"30\" y1=\"10\" x2=\"12\" y2=\"46\" stroke=\"#000\" stroke-width=\"3\" stroke-linecap=\"round\"/><line x1=\"30\" y1=\"10\" x2=\"48\" y2=\"46\" stroke=\"#000\" stroke-width=\"3\" stroke-linecap=\"round\"/><path d=\"M 12 46 A 18 5 0 0 0 48 46\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/></svg>\n          conos: <span class=\"conteo-hueco\"></span>\n        </div>\n      </div>\n    </div>\n  </div>",
