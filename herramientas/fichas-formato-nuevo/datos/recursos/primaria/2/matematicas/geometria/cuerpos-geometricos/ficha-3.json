.5\" stroke-linecap=\"round\"/><line x1=\"30\" y1=\"8\" x2=\"50\" y2=\"46\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linecap=\"round\"/><line x1=\"30\" y1=\"8\" x2=\"30\" y2=\"54\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linecap=\"round\"/><polyline points=\"10,46 30,54 50,46\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/></svg></div>\n      <div class=\"intruso-fig\"><svg class=\"figura-mini\" viewBox=\"0 0 60 60\"><line x1=\"30\" y1=\"8\" x2=\"10\" y2=\"46\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linecap=\"round\"/><line x1=\"30\" y1=\"8\" x2=\"50\" y2=\"46\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linecap=\"round\"/><line x1=\"30\" y1=\"8\" x2=\"30\" y2=\"54\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linecap=\"round\"/><polyline points=\"10,46 30,54 50,46\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/></svg></div>\n      <div class=\"intruso-fig\"><svg class=\"figura-mini\" viewBox=\"0 0 60 60\"><circle cx=\"30\" cy=\"30\" r=\"22\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/><ellipse cx=\"30\" cy=\"30\" rx=\"22\" ry=\"7\" fill=\"none\" stroke=\"#000\" stroke-width=\"1.5\"/></svg></div>\n      <div class=\"intruso-fig\"><svg class=\"figura-mini\" viewBox=\"0 0 60 60\"><line x1=\"30\" y1=\"8\" x2=\"10\" y2=\"46\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linecap=\"round\"/><line x1=\"30\" y1=\"8\" x2=\"50\" y2=\"46\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linecap=\"round\"/><line x1=\"30\" y1=\"8\" x2=\"30\" y2=\"54\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linecap=\"round\"/><polyline points=\"10,46 30,54 50,46\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/></svg></div>\n    </div>\n  </div>",
  "<div class=\"ej-block\">\n    <div class=\"ej-enunciado\"><span class=\"num\">4.</span> <strong>Adivina</strong> qué cuerpo geométrico es:</div>\n    <div class=\"frases\">\n      <div class=\"frase\">a) Tengo 6 caras iguales. Soy el <span class=\"hueco-frase\"></span>.</div>\n      <div class=\"frase\">b) Soy redonda del todo y ruedo en todas las direcciones. Soy la <span class=\"hueco-frase\"></span>.</div>\n      <div class=\"frase\">c) Tengo una sola cara plana y termino en punta. Soy el <span class=\"hueco-frase\"></span>.</div>\n      <div class=\"frase\">d) Mis caras de los lados son triángulos. Soy la <span class=\"hueco-frase\"></span>.</div>\n    </div>\n  </div>"
