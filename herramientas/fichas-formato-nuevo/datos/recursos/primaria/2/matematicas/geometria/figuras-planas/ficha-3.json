 "css": ".mz *,.mz *::before,.mz *::after{box-sizing: border-box; margin: 0; padding: 0;}\n.mz .figura-mini{width: 38px; height: 38px;}\n.mz .objetos-grid{display: grid; grid-template-columns: 1fr 1fr; gap: 6px 40px; align-items: center;}\n.mz .objetos-col{display: flex; flex-direction: column; gap: 6px; align-items: center;}\n.mz .objeto-caja{display: flex; align-items: center; gap: 8px; min-height: 44px;}\n.mz .objeto-caja svg{width: 42px; height: 42px;}\n.mz .objeto-nombre{font-family: sans-serif; font-size: 10px; color: #555;}\n.mz .objetos-nom{border: 1.5px solid var(--bosque); border-radius: 8px; padding: 6px 8px; text-align: center; font-size: 13.5px; font-weight: 700; width: 100%;}\n.mz .robot-grid{display: grid; grid-template-columns: 230px 1fr; gap: 18px; align-items: center;}\n.mz .robot-caja{border: 1.5px solid var(--bosque); border-radius: 10px; padding: 6px; display: flex; justify-content: center;}\n.mz .conteo-lista{display: flex; flex-direction: column; gap: 7px;}\n.mz .conteo-item{display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600;}\n.mz .conteo-hueco{width: 36px; height: 24px; border: 1.5px solid var(--bosque); border-radius: 5px; flex-shrink: 0;}\n.mz .conteo-fig{width: 26px; height: 26px; flex-shrink: 0;}\n.mz .intruso-fila{display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 6px;}\n.mz .intruso-fig{border: 1.5px dashed #000; border-radius: 8px; padding: 3px; display: flex; align-items: center; justify-content: center; min-height: 46px;}\n.mz .serie-fila{display: flex; gap: 6px; align-items: center; margin-bottom: 8px;}\n.mz .serie-celda{border: 1.5px solid var(--bosque); border-radius: 8px; width: 56px; height: 52px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;}\n.mz .serie-celda.vacia{border-style: dashed;}\n.mz .serie-celda svg{width: 36px; height: 36px;}",
