  "<svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\">\n    <defs>\n      <!-- Moneda EURO (con anillo bicolor + 12 estrellas) -->\n      <symbol id=\"moneda-euro\" viewBox=\"0 0 100 100\">\n        <circle cx=\"50\" cy=\"50\" r=\"47\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"2.5\"/>\n        <circle cx=\"50\" cy=\"50\" r=\"34\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"1.5\"/>\n        <g fill=\"#000\" font-family=\"sans-serif\" font-size=\"7\" text-anchor=\"middle\">\n          <text x=\"50\" y=\"9\">★</text>\n          <text x=\"69\" y=\"13\">★</text>\n          <text x=\"83\" y=\"26\">★</text>\n          <text x=\"89\" y=\"44\">★</text>\n          <text x=\"89\" y=\"60\">★</text>\n          <text x=\"83\" y=\"78\">★</text>\n          <text x=\"69\" y=\"91\">★</text>\n          <text x=\"50\" y=\"95\">★</text>\n          <text x=\"31\" y=\"91\">★</text>\n          <text x=\"17\" y=\"78\">★</text>\n          <text x=\"11\" y=\"60\">★</text>\n          <text x=\"11\" y=\"44\">★</text>\n        </g>\n        <text class=\"val\" x=\"50\" y=\"58\" text-anchor=\"middle\" font-size=\"22\" font-weight=\"800\" font-family=\"sans-serif\" fill=\"#000\">1€</text>\n        <text x=\"50\" y=\"73\" text-anchor=\"middle\" font-size=\"6\" font-weight=\"700\" font-family=\"sans-serif\" letter-spacing=\"1\" fill=\"#000\">EURO</text>\n      </symbol>\n\n      <!-- Moneda CÉNTIMO (sin anillo, solo círculo) -->\n      <symbol id=\"moneda-cent\" viewBox=\"0 0 100 100\">\n        <circle cx=\"50\" cy=\"50\" r=\"47\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"2.5\"/>\n        <g fill=\"#000\" font-family=\"sans-serif\" font-size=\"6\" text-anchor=\"middle\">\n          <text x=\"50\" y=\"13\">★</text>\n          <text x=\"74\" y=\"20\">★</text>\n          <text x=\"86\" y=\"40\">★</text>\n          <text x=\"86\" y=\"62\">★</text>\n          <text x=\"74\" y=\"83\">★</text>\n          <text x=\"50\" y=\"91\">★</text>\n          <text x=\"26\" y=\"83\">★</text>\n          <text x=\"14\" y=\"62\">★</text>\n          <text x=\"14\" y=\"40\">★</text>\n          <text x=\"26\" y=\"20\">★</text>\n        </g>\n        <text class=\"val\" x=\"50\" y=\"58\" text-anchor=\"middle\" font-size=\"26\" font-weight=\"800\" font-family=\"sans-serif\" fill=\"#000\">50</text>\n        <text x=\"50\" y=\"74\" text-anchor=\"middle\" font-size=\"7\" font-weight=\"700\" font-family=\"sans-serif\" letter-spacing=\"1\" fill=\"#000\">CENT</text>\n      </symbol>\n\n      <!-- Billete -->\n      <symbol id=\"billete\" viewBox=\"0 0 160 90\">\n        <rect x=\"3\" y=\"3\" width=\"154\" height=\"84\" rx=\"6\" fill=\"#fff\" stroke=\"#000\" stroke-width=\"2.5\"/>\n        <rect x=\"9\" y=\"9\" width=\"142\" height=\"72\" rx=\"3\" fill=\"none\" stroke=\"#000\" stroke-width=\"1\"/>\n        <text class=\"val\" x=\"14\" y=\"24\" font-size=\"13\" font-weight=\"800\" font-family=\"sans-serif\" fill=\"#000\">5</text>\n        <text class=\"val\" x=\"146\" y=\"24\" font-size=\"13\" font-weight=\"800\" font-family=\"sans-serif\" text-anchor=\"end\" fill=\"#000\">5</text>\n        <text x=\"80\" y=\"38\" text-anchor=\"middle\" font-size=\"9\" font-weight=\"700\" font-family=\"sans-serif\" letter-spacing=\"3\" fill=\"#000\">EURO</text>\n        <text class=\"val\" x=\"80\" y=\"66\" text-anchor=\"middle\" font-size=\"26\" font-weight=\"800\" font-family=\"sans-serif\" fill=\"#000\">5</text>\n        <g fill=\"#000\" font-family=\"sans-serif\" font-size=\"7\" text-anchor=\"middle\">\n          <text x=\"32\" y=\"80\">★</text>\n          <text x=\"44\" y=\"83\">★</text>\n          <text x=\"60\" y=\"83\">★</text>\n          <text x=\"80\" y=\"84\">★</text>\n          <text x=\"100\" y=\"83\">★</text>\n          <text x=\"116\" y=\"83\">★</text>\n          <text x=\"128\" y=\"80\">★</text>\n        </g>\n      </symbol>\n    </defs>\n  </svg>",
  "<div class=\"recuerda\">\n    <div class=\"recuerda-titulo\">💡 Recuerda</div>\n    <div class=\"recuerda-idea\"><strong>Monedas:</strong> son redondas. Hay de <strong>céntimos</strong> (1c, 2c, 5c, 10c, 20c, 50c) y de <strong>euros</strong> (1€, 2€).</div>\n    <div class=\"recuerda-idea\"><strong>Billetes:</strong> son rectangulares y de papel. Los más usados: <strong>5€, 10€ y 20€</strong>.</div>\n    <div class=\"recuerda-idea\"><strong>100 céntimos = 1 euro.</strong> El símbolo del euro es <strong>€</strong> y el de céntimo es <strong>c</strong>.</div>\n  </div>",
