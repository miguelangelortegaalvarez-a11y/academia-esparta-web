 "css": ".mz *,.mz *::before,.mz *::after{box-sizing: border-box; margin: 0; padding: 0;}\n.mz .recuerda{border: 2px solid var(--bosque); border-radius: 10px; padding: 7px 12px; margin-bottom: 8px;}\n.mz .recuerda-titulo{font-size: 13px; font-weight: 700; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;}\n.mz .recuerda-idea{font-size: 12.5px; margin-bottom: 3px; line-height: 1.3;}\n.mz .recuerda-idea strong{font-weight: 700;}\n.mz .reloj{width: 78px; height: 78px; display: inline-block; vertical-align: middle;}\n.mz .reloj-mini{width: 64px; height: 64px; display: inline-block; vertical-align: middle;}\n.mz .digital{font-family: 'Courier New', monospace; font-weight: 800; font-size: 24px; border: 2px solid var(--bosque); border-radius: 6px; padding: 4px 12px; display: inline-block; background: #fff;}\n.mz .digital-mini{font-family: 'Courier New', monospace; font-weight: 800; font-size: 18px; border: 2px solid var(--bosque); border-radius: 6px; padding: 3px 10px; display: inline-block; background: #fff;}\n.mz .unir-fila{display: grid; grid-template-columns: 90px 1fr 90px; align-items: center; gap: 8px; margin-bottom: 4px;}\n.mz .unir-izq{display: flex; justify-content: flex-start;}\n.mz .unir-der{display: flex; justify-content: flex-end;}\n.mz .unir-libre{height: 10px;}\n.mz .escribir-fila{display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 4px; justify-items: center;}\n.mz .escribir-caja{display: flex; flex-direction: column; align-items: center; gap: 4px;}\n.mz .escribir-hueco{width: 70px; border: 1.5px solid var(--bosque); border-radius: 4px; height: 26px;}\n.mz .dibujar-fila{display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 4px; justify-items: center;}\n.mz .dibujar-caja{display: flex; flex-direction: column; align-items: center; gap: 4px;}\n.mz .recuerda-idea{line-height: 1.875 !important;}",
