h></tr>\n        <tr>\n          <td class=\"cat\"><svg viewBox=\"0 0 60 60\"><path d=\"M 8 40 L 10 32 Q 12 26 18 26 L 42 26 Q 48 26 50 32 L 52 40 Z\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/><circle cx=\"18\" cy=\"44\" r=\"5\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/><circle cx=\"42\" cy=\"44\" r=\"5\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/></svg></td>\n          <td class=\"zona-libre\"></td>\n        </tr>\n        <tr>\n          <td class=\"cat\"><svg viewBox=\"0 0 60 60\"><circle cx=\"16\" cy=\"42\" r=\"9\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/><circle cx=\"44\" cy=\"42\" r=\"9\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/><line x1=\"16\" y1=\"42\" x2=\"28\" y2=\"22\" stroke=\"#000\" stroke-width=\"2.5\"/><line x1=\"28\" y1=\"22\" x2=\"44\" y2=\"42\" stroke=\"#000\" stroke-width=\"2.5\"/></svg></td>\n          <td class=\"zona-libre\"></td>\n        </tr>\n        <tr>\n          <td class=\"cat\"><svg viewBox=\"0 0 60 60\"><path d=\"M 8 32 L 26 28 L 36 18 L 40 18 L 36 30 L 48 30 L 52 26 L 54 28 L 50 34 L 54 38 L 52 40 L 48 36 L 36 36 L 40 48 L 36 48 L 26 38 L 8 34 Z\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/></svg></td>\n          <td class=\"zona-libre\"></td>\n        </tr>\n        <tr>\n          <td class=\"cat\"><svg viewBox=\"0 0 60 60\"><line x1=\"30\" y1=\"8\" x2=\"30\" y2=\"38\" stroke=\"#000\" stroke-width=\"2.5\"/><path d=\"M 30 12 L 46 34 L 30 34 Z\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/><path d=\"M 8 38 L 52 38 L 46 50 L 14 50 Z\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/></svg></td>\n          <td class=\"zona-libre\"></td>\n        </tr>\n      </table>\n    </div>\n  </div>",
  "<div class=\"ej-block\">\n    <div class=\"ej-enunciado\"><span class=\"num\">4.</span> Mira la tabla del ejercicio 3 y <strong>ordena</strong> los transportes de la que hay <strong>MÁS</strong> a la que hay <strong>MENOS</strong>:</div>\n    <div class=\"ordenar-puestos\">\n      <div class=\"ordenar-puesto\">\n        <span class=\"ordenar-num\">1.º (más)</span>\n        <div class=\"ordenar-hueco\"></div>\n      </div>\n      <div class=\"ordenar-puesto\">\n        <span class=\"ordenar-num\">2.º</span>\n        <div class=\"ordenar-hueco\"></div>\n      </div>\n      <div class=\"ordenar-puesto\">\n        <span class=\"ordenar-num\">3.º</span>\n        <div class=\"ordenar-hueco\"></div>\n      </div>\n      <div class=\"ordenar-puesto\">\n        <span class=\"ordenar-num\">4.º (menos)</span>\n        <div class=\"ordenar-hueco\"></div>\n      </div>\n    </div>\n  </div>"
