  "<div class=\"recuerda\">\n    <div class=\"recuerda-titulo\">💡 Recuerda</div>\n    <div class=\"recuerda-idea\">Un <strong>pictograma</strong> es un gráfico con <strong>dibujitos</strong>. Cada <strong>dibujito vale 1</strong>. Para saber cuántos hay solo tienes que <strong>contar los dibujitos</strong> de cada fila.</div>\n    <div class=\"recuerda-ejemplo\">\n      <table class=\"picto\">\n        <tr><th>Fruta</th><th>Pictograma</th><th>Total</th></tr>\n        <tr>\n          <td class=\"cat\"><svg viewBox=\"0 0 60 60\"><path d=\"M 30 18 Q 16 18 16 34 Q 16 50 30 52 Q 44 50 44 34 Q 44 18 30 18 Z\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/><line x1=\"30\" y1=\"18\" x2=\"32\" y2=\"10\" stroke=\"#000\" stroke-width=\"2.5\"/></svg></td>\n          <td class=\"iconos\">\n            <svg viewBox=\"0 0 60 60\"><path d=\"M 30 18 Q 16 18 16 34 Q 16 50 30 52 Q 44 50 44 34 Q 44 18 30 18 Z\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/><line x1=\"30\" y1=\"18\" x2=\"32\" y2=\"10\" stroke=\"#000\" stroke-width=\"2\"/></svg>\n            <svg viewBox=\"0 0 60 60\"><path d=\"M 30 18 Q 16 18 16 34 Q 16 50 30 52 Q 44 50 44 34 Q 44 18 30 18 Z\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/><line x1=\"30\" y1=\"18\" x2=\"32\" y2=\"10\" stroke=\"#000\" stroke-width=\"2\"/></svg>\n            <svg viewBox=\"0 0 60 60\"><path d=\"M 30 18 Q 16 18 16 34 Q 16 50 30 52 Q 44 50 44 34 Q 44 18 30 18 Z\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/><line x1=\"30\" y1=\"18\" x2=\"32\" y2=\"10\" stroke=\"#000\" stroke-width=\"2\"/></svg>\n          </td>\n          <td>3</td>\n        </tr>\n      </table>\n    </div>\n    <div class=\"picto-leyenda\">Cada <svg viewBox=\"0 0 60 60\" style=\"width:14px;height:14px;vertical-align:middle\"><path d=\"M 30 18 Q 16 18 16 34 Q 16 50 30 52 Q 44 50 44 34 Q 44 18 30 18 Z\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/></svg> = 1 manzana</div>\n  </div>",
