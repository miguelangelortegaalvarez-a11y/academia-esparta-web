que); height: 22px; vertical-align: middle; margin-left: 4px;}\n.mz .e3-wrap{display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: stretch;}\n.mz .picto-vacio{border-collapse: collapse; font-size: 13px; width: 100%;}\n.mz .picto-vacio th,.mz .picto-vacio td{border: 1.5px solid var(--bosque); padding: 4px 6px; text-align: center; font-weight: 700;}\n.mz .picto-vacio th{background: #f3f3f3; font-size: 11.5px; font-family: sans-serif;}\n.mz .picto-vacio .cat{width: 50px;}\n.mz .picto-vacio .cat svg{width: 28px; height: 28px; vertical-align: middle;}\n.mz .picto-vacio .zona-libre{height: 32px; min-width: 200px;}\n.mz .preg-fila,.mz .recuerda-idea{line-height: 1.875 !important;}",
