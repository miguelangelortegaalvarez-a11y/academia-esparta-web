 "css": ".mz *,.mz *::before,.mz *::after{box-sizing: border-box; margin: 0; padding: 0;}\n.mz .e1-wrap{display: grid; grid-template-columns: 1fr auto; gap: 14px; align-items: center;}\n.mz .mosaico{border: 2px solid var(--bosque); border-radius: 10px; padding: 8px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; justify-items: center; align-items: center;}\n.mz .mosaico svg{width: 36px; height: 36px;}\n.mz .tabla-rellenar{border-collapse: collapse; font-size: 13px;}\n.mz .tabla-rellenar th,.mz .tabla-rellenar td{border: 1.5px solid var(--bosque); padding: 4px 10px; text-align: center; font-weight: 700;}\n.mz .tabla-rellenar th{background: #f3f3f3; font-size: 11.5px; font-family: sans-serif;}\n.mz .tabla-rellenar svg{width: 26px; height: 26px; vertical-align: middle;}\n.mz .tabla-rellenar .hueco{min-width: 36px; height: 18px;}\n.mz .e2-wrap{display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: center;}\n.mz .preg-lista{display: flex; flex-direction: column; gap: 4px;}\n.mz .preg-fila{font-size: 12px; line-height: 1.35;}\n.mz .preg-hueco{display: inline-block; min-width: 36px; border-bottom: 1.5px solid var(--bosque); height: 18px; vertical-align: middle; margin-left: 4px;}\n.mz .preg-hueco-grande{display: inline-block; min-width: 90px; border-bottom: 1.5px solid var(--bosque); height: 18px; vertical-align: middle; margin-left: 4px;}\n.mz .vf-lista{display: flex; flex-direction: column; gap: 5px;}\n.mz .vf-fila{display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center; font-size: 12px; line-height: 1.3; border-bottom: 1px dashed #999; padding-bottom: 4px;}\n.mz .vf-fila:last-child{border-bottom: none; padding-bottom: 0;}\n.mz .vf-opciones{display: flex; gap: 12px; font-family: sans-serif; font-size: 11px; font-weight: 700;}\n.mz .vf-opciones .opt{border: 1.5px solid var(--bosque); border-radius: 999px; padding: 2px 9px;}\n.mz .e4-wrap{display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: center;