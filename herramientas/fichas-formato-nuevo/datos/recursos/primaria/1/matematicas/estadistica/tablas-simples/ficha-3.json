"10\" y1=\"42\" x2=\"14\" y2=\"52\" stroke=\"#000\" stroke-width=\"2.5\"/></svg>\n        <!-- libro -->\n        <svg viewBox=\"0 0 60 60\"><rect x=\"12\" y=\"12\" width=\"36\" height=\"40\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/><line x1=\"18\" y1=\"12\" x2=\"18\" y2=\"52\" stroke=\"#000\" stroke-width=\"2\"/><line x1=\"24\" y1=\"22\" x2=\"44\" y2=\"22\" stroke=\"#000\" stroke-width=\"1.5\"/><line x1=\"24\" y1=\"30\" x2=\"44\" y2=\"30\" stroke=\"#000\" stroke-width=\"1.5\"/><line x1=\"24\" y1=\"38\" x2=\"44\" y2=\"38\" stroke=\"#000\" stroke-width=\"1.5\"/></svg>\n        <!-- lápiz -->\n        <svg viewBox=\"0 0 60 60\"><polygon points=\"10,42 14,52 24,48\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/><polygon points=\"14,42 24,48 50,12 44,6\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/><line x1=\"10\" y1=\"42\" x2=\"14\" y2=\"52\" stroke=\"#000\" stroke-width=\"2.5\"/></svg>\n        <!-- goma -->\n        <svg viewBox=\"0 0 60 60\"><rect x=\"10\" y=\"22\" width=\"40\" height=\"16\" rx=\"3\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/><line x1=\"10\" y1=\"30\" x2=\"50\" y2=\"30\" stroke=\"#000\" stroke-width=\"2\"/></svg>\n        <!-- lápiz -->\n        <svg viewBox=\"0 0 60 60\"><polygon points=\"10,42 14,52 24,48\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/><polygon points=\"14,42 24,48 50,12 44,6\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/><line x1=\"10\" y1=\"42\" x2=\"14\" y2=\"52\" stroke=\"#000\" stroke-width=\"2.5\"/></svg>\n        <!-- sacapuntas -->\n        <svg viewBox=\"0 0 60 60\"><polygon points=\"10,22 50,22 44,42 16,42\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/><circle cx=\"30\" cy=\"32\" r=\"4\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/></svg>\n        <!-- libro -->\n        <svg viewBox=\"0 0 60 60\"><rect x=\"12\" y=\"12\" width=\"36\" he