"44\" y2=\"38\" stroke=\"#000\" stroke-width=\"2\"/></svg></td>\n          <td class=\"hueco\"></td>\n        </tr>\n        <tr>\n          <td><svg viewBox=\"0 0 60 60\"><polygon points=\"10,22 50,22 44,42 16,42\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/><circle cx=\"30\" cy=\"32\" r=\"4\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg></td>\n          <td class=\"hueco\"></td>\n        </tr>\n      </table>\n    </div>\n  </div>",
  "<div class=\"ej-block\">\n    <div class=\"ej-enunciado\"><span class=\"num\">2.</span> Mira la tabla de la <strong>clase de Sara</strong> y <strong>responde</strong>:</div>\n    <div class=\"e2-wrap\">\n      <table class=\"tabla-rellenar\">\n        <tr><th>Objeto</th><th>Cantidad</th></tr>\n        <tr>\n          <td><svg viewBox=\"0 0 60 60\"><polygon points=\"10,42 14,52 24,48\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polygon points=\"14,42 24,48 50,12 44,6\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/></svg></td>\n          <td>8</td>\n        </tr>\n        <tr>\n          <td><svg viewBox=\"0 0 60 60\"><rect x=\"10\" y=\"22\" width=\"40\" height=\"16\" rx=\"3\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/><line x1=\"10\" y1=\"30\" x2=\"50\" y2=\"30\" stroke=\"#000\" stroke-width=\"2.5\"/></svg></td>\n          <td>5</td>\n        </tr>\n        <tr>\n          <td><svg viewBox=\"0 0 60 60\"><rect x=\"12\" y=\"12\" width=\"36\" height=\"40\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/><line x1=\"18\" y1=\"12\" x2=\"18\" y2=\"52\" stroke=\"#000\" stroke-width=\"2.5\"/><line x1=\"24\" y1=\"22\" x2=\"44\" y2=\"22\" stroke=\"#000\" stroke-width=\"2\"/><line x1=\"24\" y1=\"30\" x2=\"44\" y2=\"30\" stroke=\"#000\" stroke-width=\"2\"/><line x1=\"24\" y1=\"38\" x2=\"44\" y2=\"38\" stroke=\"#000\" stroke-width=\"2\"/></svg></td>\n          <td>3</td>\n        </tr>\n      </table>\n      <div class=\"preg-lista\">\n        <div class=\"preg-fila\">a) ¿Cuántos <strong>lápices</strong> hay? <span class=\"preg-hueco\"></span></div>\n        <div class=\"preg-fila\">b) ¿Cuántos <strong>libros</strong> hay? <span class=\"preg-hueco\"></span></div>\n        <div class=\"preg-fila\">c) ¿De qué objeto hay <strong>MÁS</strong>? <span class=\"preg-hueco-grande\"></span></div>\n        <div class=\"preg-fila\">d) ¿De qué objeto hay <strong>MENOS</strong>? <span class=\"preg-hueco-grande\"></span></div>\n        <div class=\"preg-fila\">e) ¿Cuántos objetos hay <strong>EN TOTAL</strong>? <span class=\"preg-hueco\"></span></div>\n      </div>\n    </div>\n  </div>",
  "<div class=\"ej-block\">\n    <div class=\"ej-enunciado\"><span class=\"num\">3.</span> Mira otra vez la tabla del ejercicio 2 y <strong>rodea V</strong> (verdadero) o <strong>F</strong> (falso):</div>\n    <div class=\"vf-lista\">\n      <div class=\"vf-fila\">\n        <span>a) Hay <strong>8 lápices</strong>.</span>\n        <span class=\"vf-opciones\"><span class=\"opt\">V</span><span class=\"opt\">F</span></span>\n      </div>\n      <div class=\"vf-fila\">\n        <span>b) Hay <strong>más libros que gomas</strong>.</span>\n        <span class=\"vf-opciones\"><span class=\"opt\">V</span><span class=\"opt\">F</span></span>\n      </div>\n      <div class=\"vf-fila\">\n        <span>c) Hay <strong>menos libros que lápices</strong>.</span>\n        <span class=\"vf-opciones\"><span class=\"opt\">V</span><span class=\"opt\">F</span></span>\n      </div>\n      <div class=\"vf-fila\">\n        <span>d) <strong>En total</strong> hay <strong>16 objetos</strong>.</span>\n        <span class=\"vf-opciones\"><span class=\"opt\">V</span><span class=\"opt\">F</span></span>\n      </div>\n    </div>\n  </div>",
  "<div class=\"ej-block\">\n    <div class=\"ej-enunciado\"><span class=\"num\">4.</span> Mira esta tabla y <strong>ordena</strong> los objetos de la que hay <strong>MÁS</strong> a la que hay <strong>MENOS</strong>:</div>\n    <div class=\"e4-wrap\">\n      <table class=\"tabla-rellenar\">\n        <tr><th>Objeto</th><th>Cantidad</th></tr>\n        <tr>\n          <td><svg viewBox=\"0 0 60 60\"><polygon points=\"10,42 14,52 24,48\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/><polygon points=\"14,42 24,48 50,12 44,6\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/></svg></td>\n          <td>7</td>\n        </tr>\n        <tr>\n          <td><svg viewBox=\"0 0 60 60\"><rect x=\"10\" y=\"22\" width=\"40\" height=\"16\" rx=\"3\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/><line x1=\"10\" y1=\"30\" x2=\"50\" y2=\"30\" stroke=\"#000\" stroke-width=\"2.5\"/></svg></td>\n          <td>2</td>\n        </tr>\n        <tr>\n          <td><svg viewBox=\"0 0 60 60\"><rect x=\"12\" y=\"12\" width=\"36\" height=\"40\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\"/><line x1=\"18\" y1=\"12\" x2=\"18\" y2=\"52\" stroke=\"#000\" stroke-width=\"2.5\"/><line x1=\"24\" y1=\"22\" x2=\"44\" y2=\"22\" stroke=\"#000\" stroke-width=\"2\"/><line x1=\"24\" y1=\"30\" x2=\"44\" y2=\"30\" stroke=\"#000\" stroke-width=\"2\"/><line x1=\"24\" y1=\"38\" x2=\"44\" y2=\"38\" stroke=\"#000\" stroke-width=\"2\"/></svg></td>\n          <td>5</td>\n        </tr>\n        <tr>\n          <td><svg viewBox=\"0 0 60 60\"><polygon points=\"10,22 50,22 44,42 16,42\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/><circle cx=\"30\" cy=\"32\" r=\"4\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg></td>\n          <td>4</td>\n        </tr>\n      </table>\n      <div class=\"ordenar-puestos\">\n        <div class=\"ordenar-puesto\">\n          <span class=\"ordenar-num\">1.º (más)</span>\n          <div class=\"ordenar-hueco\"></div>\n        </div>\n        <div class=\"ordenar-puesto\">\n          <span class=\"ordenar-num\">2.º</span>\n          <div class=\"ordenar-hueco\"></div>\n        </div>\n        <div class=\"ordenar-puesto\">\n          <span class=\"ordenar-num\">3.º</span>\n          <div class=\"ordenar-hueco\"></div>\n        </div>\n        <div class=\"ordenar-puesto\">\n          <span class=\"ordenar-num\">4.º (menos)</span>\n          <div class=\"ordenar-hueco\"></div>\n        </div>\n      </div>\n    </div>\n  </div>"
