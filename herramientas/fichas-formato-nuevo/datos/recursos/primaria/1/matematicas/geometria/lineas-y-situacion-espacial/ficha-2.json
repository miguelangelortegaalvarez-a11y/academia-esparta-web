 "bloques": [
  "<div class=\"ej-block\">\n    <div class=\"ej-enunciado\"><span class=\"num\">1.</span> Completa con <strong>dentro</strong> o <strong>fuera</strong>: <span class=\"ej-banco\">(banco: dentro / fuera)</span></div>\n    <div class=\"mini-grid\">\n      <div class=\"mini-caja\">\n        <div class=\"mini-svg\">\n          <svg viewBox=\"0 0 100 70\">\n            <rect x=\"14\" y=\"18\" width=\"72\" height=\"44\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <circle cx=\"50\" cy=\"42\" r=\"11\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n          </svg>\n        </div>\n        <div class=\"mini-frase\">La pelota está <span class=\"mini-hueco\"></span> de la caja.</div>\n      </div>\n      <div class=\"mini-caja\">\n        <div class=\"mini-svg\">\n          <svg viewBox=\"0 0 100 70\">\n            <rect x=\"14\" y=\"20\" width=\"60\" height=\"42\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <circle cx=\"86\" cy=\"44\" r=\"10\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n          </svg>\n        </div>\n        <div class=\"mini-frase\">La pelota está <span class=\"mini-hueco\"></span> de la caja.</div>\n      </div>\n      <div class=\"mini-caja\">\n        <div class=\"mini-svg\">\n          <svg viewBox=\"0 0 100 70\">\n            <ellipse cx=\"50\" cy=\"50\" rx=\"36\" ry=\"12\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <path d=\"M 32 18 L 40 38 L 24 38 Z\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n            <line x1=\"32\" y1=\"38\" x2=\"32\" y2=\"50\" stroke=\"#000\" stroke-width=\"2.5\"/>\n          </svg>\n        </div>\n        <div class=\"mini-frase\">El pez está <span class=\"mini-hueco\"></span> de la pecera.</div>\n      </div>\n      <div class=\"mini-caja\">\n        <div class=\"mini-svg\">\n          <svg viewBox=\"0 0 100 70\">\n            <ellipse cx=\"50\" cy=\"44\" rx=\"36\" ry=\"20\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <path d=\"M 50 38 L 58 50 L 42 50 Z\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n          </svg>\n        </div>\n        <div class=\"mini-frase\">El pez está <span class=\"mini-hueco\"></span> de la pecera.</div>\n      </div>\n    </div>\n  </div>",
  "<div class=\"ej-block\">\n    <div class=\"ej-enunciado\"><span class=\"num\">2.</span> Completa con <strong>encima</strong> o <strong>debajo</strong>: <span class=\"ej-banco\">(banco: encima / debajo)</span></div>\n    <div class=\"mini-grid\">\n      <div class=\"mini-caja\">\n        <div class=\"mini-svg\">\n          <svg viewBox=\"0 0 100 70\">\n            <line x1=\"14\" y1=\"40\" x2=\"86\" y2=\"40\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <line x1=\"22\" y1=\"40\" x2=\"22\" y2=\"62\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <line x1=\"78\" y1=\"40\" x2=\"78\" y2=\"62\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <circle cx=\"50\" cy=\"30\" r=\"8\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n          </svg>\n        </div>\n        <div class=\"mini-frase\">La pelota está <span class=\"mini-hueco\"></span> de la mesa.</div>\n      </div>\n      <div class=\"mini-caja\">\n        <div class=\"mini-svg\">\n          <svg viewBox=\"0 0 100 70\">\n            <line x1=\"14\" y1=\"30\" x2=\"86\" y2=\"30\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <line x1=\"22\" y1=\"30\" x2=\"22\" y2=\"52\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <line x1=\"78\" y1=\"30\" x2=\"78\" y2=\"52\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <circle cx=\"50\" cy=\"58\" r=\"8\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n          </svg>\n        </div>\n        <div class=\"mini-frase\">La pelota está <span class=\"mini-hueco\"></span> de la mesa.</div>\n      </div>\n      <div class=\"mini-caja\">\n        <div class=\"mini-svg\">\n          <svg viewBox=\"0 0 100 70\">\n            <polygon points=\"20,42 50,12 80,42\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n            <rect x=\"40\" y=\"42\" width=\"20\" height=\"22\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <circle cx=\"50\" cy=\"6\" r=\"4\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n          </svg>\n        </div>\n        <div class=\"mini-frase\">La pelota está <span class=\"mini-hueco\"></span> de la casa.</div>\n      </div>\n      <div class=\"mini-caja\">\n        <div class=\"mini-svg\">\n          <svg viewBox=\"0 0 100 70\">\n            <line x1=\"6\" y1=\"56\" x2=\"94\" y2=\"56\" stroke=\"#000\" stroke-width=\"2.5\"/>\n            <polygon points=\"44,32 50,18 56,32\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n            <line x1=\"50\" y1=\"32\" x2=\"50\" y2=\"42\" stroke=\"#000\" stroke-width=\"2\"/>\n            <circle cx=\"78\" cy=\"14\" r=\"5\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n          </svg>\n        </div>\n        <div class=\"mini-frase\">El sol está <span class=\"mini-hueco\"></span> del árbol.</div>\n      </div>\n    </div>\n  </div>",
  "<div class=\"ej-block\">\n    <div class=\"ej-enunciado\"><span class=\"num\">3.</span> <strong>Rodea</strong> el objeto que se indica en cada fila:</div>\n    <div class=\"rodear-lista\">\n      <div class=\"rodear-fila\">\n        <div class=\"rodear-instr\">Rodea el que está a la <strong>izquierda</strong>:</div>\n        <div class=\"rodear-opc\"><svg viewBox=\"0 0 60 42\"><polygon points=\"30,8 50,32 10,32\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/></svg></div>\n        <div class=\"rodear-opc\"><svg viewBox=\"0 0 60 42\"><circle cx=\"30\" cy=\"21\" r=\"13\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg></div>\n        <div class=\"rodear-opc\"><svg viewBox=\"0 0 60 42\"><rect x=\"14\" y=\"8\" width=\"32\" height=\"26\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg></div>\n      </div>\n      <div class=\"rodear-fila\">\n        <div class=\"rodear-instr\">Rodea el que está a la <strong>derecha</strong>:</div>\n        <div class=\"rodear-opc\"><svg viewBox=\"0 0 60 42\"><circle cx=\"30\" cy=\"21\" r=\"13\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg></div>\n        <div class=\"rodear-opc\"><svg viewBox=\"0 0 60 42\"><rect x=\"14\" y=\"8\" width=\"32\" height=\"26\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg></div>\n        <div class=\"rodear-opc\"><svg viewBox=\"0 0 60 42\"><polygon points=\"30,8 50,32 10,32\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/></svg></div>\n      </div>\n      <div class=\"rodear-fila\">\n        <div class=\"rodear-instr\">Rodea el que está en el <strong>medio</strong>:</div>\n        <div class=\"rodear-opc\"><svg viewBox=\"0 0 60 42\"><rect x=\"14\" y=\"8\" width=\"32\" height=\"26\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg></div>\n        <div class=\"rodear-opc\"><svg viewBox=\"0 0 60 42\"><polygon points=\"30,8 50,32 10,32\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/></svg></div>\n        <div class=\"rodear-opc\"><svg viewBox=\"0 0 60 42\"><circle cx=\"30\" cy=\"21\" r=\"13\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg></div>\n      </div>\n    </div>\n  </div>",
  "<div class=\"ej-block\">\n    <div class=\"ej-enunciado\"><span class=\"num\">4.</span> Mira el dibujo y rodea <strong>V</strong> (verdadero) o <strong>F</strong> (falso):</div>\n    <div class=\"escena-wrap\">\n      <div class=\"escena-svg\">\n        <svg viewBox=\"0 0 240 150\" preserveAspectRatio=\"xMidYMid meet\">\n          <!-- suelo -->\n          <line x1=\"10\" y1=\"138\" x2=\"230\" y2=\"138\" stroke=\"#000\" stroke-width=\"2\"/>\n          <!-- árbol a la izquierda -->\n          <polygon points=\"50,60 30,100 70,100\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n          <rect x=\"44\" y=\"100\" width=\"12\" height=\"20\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n          <!-- sol arriba -->\n          <circle cx=\"120\" cy=\"22\" r=\"11\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n          <!-- mesa en el centro -->\n          <line x1=\"95\" y1=\"100\" x2=\"160\" y2=\"100\" stroke=\"#000\" stroke-width=\"2.5\"/>\n          <line x1=\"102\" y1=\"100\" x2=\"102\" y2=\"125\" stroke=\"#000\" stroke-width=\"2.5\"/>\n          <line x1=\"153\" y1=\"100\" x2=\"153\" y2=\"125\" stroke=\"#000\" stroke-width=\"2.5\"/>\n          <!-- pelota encima de la mesa -->\n          <circle cx=\"128\" cy=\"90\" r=\"8\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n          <!-- caja a la derecha -->\n          <rect x=\"180\" y=\"100\" width=\"38\" height=\"32\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/>\n          <!-- pájaro debajo del árbol -->\n          <ellipse cx=\"40\" cy=\"128\" rx=\"8\" ry=\"5\" fill=\"none\" stroke=\"#000\" stroke-width=\"2\"/>\n          <line x1=\"48\" y1=\"128\" x2=\"54\" y2=\"125\" stroke=\"#000\" stroke-width=\"1.5\"/>\n        </svg>\n      </div>\n      <div class=\"vf-lista\">\n        <div class=\"vf-fila\">\n          <div class=\"vf-frase\">a) La pelota está <strong>encima</strong> de la mesa.</div>\n          <div class=\"vf-opcion\"><div class=\"vf-circ\"></div>V</div>\n          <div class=\"vf-opcion\"><div class=\"vf-circ\"></div>F</div>\n        </div>\n        <div class=\"vf-fila\">\n          <div class=\"vf-frase\">b) El árbol está a la <strong>derecha</strong>.</div>\n          <div class=\"vf-opcion\"><div class=\"vf-circ\"></div>V</div>\n          <div class=\"vf-opcion\"><div class=\"vf-circ\"></div>F</div>\n        </div>\n        <div class=\"vf-fila\">\n          <div class=\"vf-frase\">c) La caja está a la <strong>derecha</strong>.</div>\n          <div class=\"vf-opcion\"><div class=\"vf-circ\"></div>V</div>\n          <div class=\"vf-opcion\"><div class=\"vf-circ\"></div>F</div>\n        </div>\n        <div class=\"vf-fila\">\n          <div class=\"vf-frase\">d) El sol está <strong>debajo</strong> de la mesa.</div>\n          <div class=\"vf-opcion\"><div class=\"vf-circ\"></div>V</div>\n          <div class=\"vf-opcion\"><div class=\"vf-circ\"></div>F</div>\n        </div>\n        <div class=\"vf-fila\">\n          <div class=\"vf-frase\">e) El pájaro está <strong>debajo</strong> del árbol.</div>\n          <div class=\"vf-opcion\"><div class=\"vf-circ\"></div>V</div>\n          <div class=\"vf-opcion\"><div class=\"vf-circ\"></div>F</div>\n        </div>\n      </div>\n    </div>\n  </div>"
