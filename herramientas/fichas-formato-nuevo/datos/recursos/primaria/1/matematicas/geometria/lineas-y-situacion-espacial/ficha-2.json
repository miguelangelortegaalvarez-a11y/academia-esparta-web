 "css": ".mz *,.mz *::before,.mz *::after{box-sizing: border-box; margin: 0; padding: 0;}\n.mz .ej-banco{font-family: sans-serif; font-size: 10.5px; color: #555; margin-left: 4px;}\n.mz .mini-grid{display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px;}\n.mz .mini-caja{display: flex; flex-direction: column; align-items: center; gap: 4px;}\n.mz .mini-svg{border: 1.5px solid var(--bosque); border-radius: 8px; padding: 4px; width: 100%; display: flex; align-items: center; justify-content: center; min-height: 70px;}\n.mz .mini-svg svg{width: 90px; height: 60px;}\n.mz .mini-frase{font-size: 11.5px; text-align: center; line-height: 1.25;}\n.mz .mini-hueco{display: inline-block; min-width: 60px; border-bottom: 1.5px solid var(--bosque); height: 18px; vertical-align: middle;}\n.mz .rodear-lista{display: flex; flex-direction: column; gap: 6px;}\n.mz .rodear-fila{display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 8px; align-items: center;}\n.mz .rodear-instr{font-size: 12px; font-weight: 700; line-height: 1.25;}\n.mz .rodear-opc{border: 1.5px dashed #000; border-radius: 8px; padding: 4px; display: flex; align-items: center; justify-content: center; min-height: 50px;}\n.mz .rodear-opc svg{width: 60px; height: 42px;}\n.mz .escena-wrap{display: grid; grid-template-columns: 1fr 1fr; gap: 14px; align-items: start;}\n.mz .escena-svg{border: 2px solid var(--bosque); border-radius: 10px; padding: 6px;}\n.mz .escena-svg svg{width: 100%; height: 145px; display: block;}\n.mz .vf-lista{display: flex; flex-direction: column; gap: 5px; padding-top: 2px;}\n.mz .vf-fila{display: grid; grid-template-columns: 1fr auto auto; gap: 8px; align-items: center; font-size: 12px;}\n.mz .vf-frase{line-height: 1.3;}\n.mz .vf-opcion{display: flex; align-items: center; gap: 3px; font-weight: 700; font-size: 11.5px;}\n.mz .vf-circ{width: 19px; height: 19px; border: 1.5px solid var(--bosque); border-radius: 50%;}\n.mz .mini-frase,.mz .rodear-instr,.mz .vf-frase{line-height: 1.875 !impor