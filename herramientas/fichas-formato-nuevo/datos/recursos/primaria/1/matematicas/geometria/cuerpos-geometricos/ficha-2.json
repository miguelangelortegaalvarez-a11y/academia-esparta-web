 "css": ".mz *,.mz *::before,.mz *::after{box-sizing: border-box; margin: 0; padding: 0;}\n.mz .figura-svg{width: 44px; height: 44px;}\n.mz .mosaico-wrap{display: grid; grid-template-columns: 1fr auto; gap: 14px; align-items: center;}\n.mz .mosaico{border: 2px solid var(--bosque); border-radius: 10px; padding: 10px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; justify-items: center; align-items: center;}\n.mz .mosaico svg{width: 44px; height: 44px;}\n.mz .contar-tabla{display: flex; flex-direction: column; gap: 8px;}\n.mz .contar-fila{display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700;}\n.mz .contar-fila svg{width: 28px; height: 28px; flex-shrink: 0;}\n.mz .contar-hueco{width: 36px; height: 24px; border: 1.5px solid var(--bosque); border-radius: 5px; flex-shrink: 0;}\n.mz .asociar-grid{display: grid; grid-template-columns: 1fr 1fr; gap: 8px 40px; align-items: center;}\n.mz .asociar-col{display: flex; flex-direction: column; gap: 10px; align-items: center;}\n.mz .asociar-fig{display: flex; align-items: center; justify-content: center; min-height: 46px;}\n.mz .asociar-obj{border: 1.5px solid var(--bosque); border-radius: 8px; padding: 8px; text-align: center; font-size: 13px; font-weight: 700; width: 100%;}\n.mz .ruedan-mosaico{display: grid; grid-template-columns: repeat(6, 1fr); gap: 5px;}\n.mz .ruedan-fig{border: 1.5px dashed #000; border-radius: 8px; padding: 4px; display: flex; align-items: center; justify-content: center; min-height: 48px;}\n.mz .planas-grid{display: grid; grid-template-columns: 1fr 1fr; gap: 8px 40px; align-items: center;}\n.mz .planas-col{display: flex; flex-direction: column; gap: 10px; align-items: center;}\n.mz .planas-fig{display: flex; align-items: center; justify-content: center; min-height: 46px;}\n.mz .planas-plana{border: 1.5px solid var(--bosque); border-radius: 8px; padding: 6px; display: flex; align-items: center; justify-content: center; min-height: 46px; width: 100%;}\n.mz .planas-p