 "css": ".mz *,.mz *::before,.mz *::after{box-sizing: border-box; margin: 0; padding: 0;}\n.mz .recuerda{border: 2px solid var(--bosque); border-radius: 10px; padding: 6px 12px; margin-bottom: 6px;}\n.mz .recuerda-titulo{font-size: 12.5px; font-weight: 700; margin-bottom: 3px; display: flex; align-items: center; gap: 6px;}\n.mz .recuerda-idea{font-size: 12px; margin-bottom: 3px; line-height: 1.3;}\n.mz .recuerda-figuras{display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-top: 4px;}\n.mz .rf-caja{border: 1.5px solid var(--bosque); border-radius: 8px; padding: 4px 4px; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 2px;}\n.mz .rf-nombre{font-size: 11.5px; font-weight: 700;}\n.mz .rf-info{font-family: sans-serif; font-size: 9px; color: #555;}\n.mz .figura-svg{width: 44px; height: 44px;}\n.mz .figura-mini{width: 38px; height: 38px;}\n.mz .unir-grid{display: grid; grid-template-columns: 1fr 1fr; gap: 5px 40px; align-items: center;}\n.mz .unir-col{display: flex; flex-direction: column; gap: 5px; align-items: center;}\n.mz .unir-fig{display: flex; align-items: center; justify-content: center; min-height: 44px;}\n.mz .unir-fig svg{width: 44px; height: 44px;}\n.mz .unir-nom{border: 1.5px solid var(--bosque); border-radius: 8px; padding: 7px 8px; text-align: center; font-size: 13px; font-weight: 700; width: 100%;}\n.mz .caras-grid{display: grid; grid-template-columns: 1fr 1fr; gap: 5px 40px; align-items: center;}\n.mz .caras-col{display: flex; flex-direction: column; gap: 6px; align-items: center;}\n.mz .caras-fig{display: flex; align-items: center; justify-content: center; min-height: 42px;}\n.mz .caras-fig svg{width: 42px; height: 42px;}\n.mz .caras-num{border: 1.5px solid var(--bosque); border-radius: 8px; padding: 7px 8px; text-align: center; font-size: 15px; font-weight: 700; width: 100%; font-family: sans-serif;}\n.mz .rodear-mosaico{display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px;}\n.mz .rodear-fig