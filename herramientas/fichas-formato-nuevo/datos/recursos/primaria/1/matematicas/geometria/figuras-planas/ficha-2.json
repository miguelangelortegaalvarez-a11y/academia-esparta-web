  "<div class=\"ej-block\">\n    <div class=\"ej-enunciado\"><span class=\"num\">2.</span> <strong>Une</strong> cada figura con el <strong>objeto</strong> que tiene esa forma:</div>\n    <div class=\"asociar-grid\">\n      <div class=\"asociar-col\">\n        <div class=\"asociar-fig\"><svg class=\"figura-svg\" viewBox=\"0 0 60 60\"><circle cx=\"30\" cy=\"30\" r=\"22\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg></div>\n        <div class=\"asociar-fig\"><svg class=\"figura-svg\" viewBox=\"0 0 60 60\"><polygon points=\"30,8 52,52 8,52\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/></svg></div>\n        <div class=\"asociar-fig\"><svg class=\"figura-svg\" viewBox=\"0 0 60 60\"><rect x=\"6\" y=\"16\" width=\"48\" height=\"28\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg></div>\n        <div class=\"asociar-fig\"><svg class=\"figura-svg\" viewBox=\"0 0 60 60\"><rect x=\"10\" y=\"10\" width=\"40\" height=\"40\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg></div>\n      </div>\n      <div class=\"asociar-col\">\n        <div class=\"asociar-obj\">una puerta</div>\n        <div class=\"asociar-obj\">un plato</div>\n        <div class=\"asociar-obj\">una ventana</div>\n        <div class=\"asociar-obj\">el tejado de una casa</div>\n      </div>\n    </div>\n  </div>",
