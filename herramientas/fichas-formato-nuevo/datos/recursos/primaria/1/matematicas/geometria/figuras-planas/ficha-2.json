  "<div class=\"ej-block\">\n    <div class=\"ej-enunciado\"><span class=\"num\">1.</span> <strong>Cuenta</strong> cuántas figuras hay de cada tipo en el mosaico:</div>\n    <div class=\"mosaico-wrap\">\n      <div class=\"mosaico\">\n        <svg viewBox=\"0 0 60 60\"><polygon points=\"30,8 52,52 8,52\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/></svg>\n        <svg viewBox=\"0 0 60 60\"><rect x=\"10\" y=\"10\" width=\"40\" height=\"40\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg>\n        <svg viewBox=\"0 0 60 60\"><circle cx=\"30\" cy=\"30\" r=\"22\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg>\n        <svg viewBox=\"0 0 60 60\"><rect x=\"6\" y=\"16\" width=\"48\" height=\"28\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg>\n        <svg viewBox=\"0 0 60 60\"><polygon points=\"30,8 52,52 8,52\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/></svg>\n        <svg viewBox=\"0 0 60 60\"><circle cx=\"30\" cy=\"30\" r=\"22\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg>\n        <svg viewBox=\"0 0 60 60\"><rect x=\"10\" y=\"10\" width=\"40\" height=\"40\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg>\n        <svg viewBox=\"0 0 60 60\"><polygon points=\"30,8 52,52 8,52\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/></svg>\n        <svg viewBox=\"0 0 60 60\"><rect x=\"6\" y=\"16\" width=\"48\" height=\"28\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg>\n        <svg viewBox=\"0 0 60 60\"><circle cx=\"30\" cy=\"30\" r=\"22\" fill=\"none\" stroke=\"#000\" stroke-width=\"2.5\"/></svg>\n      </div>\n      <div class=\"contar-tabla\">\n        <div class=\"contar-fila\">\n          <svg viewBox=\"0 0 60 60\"><polygon points=\"30,8 52,52 8,52\" fill=\"none\" stroke=\"#000\" stroke-width=\"3\" stroke-linejoin=\"round\"/></svg>\n          triángulos: <div class=\"contar-hueco\"></div>\n        </div>